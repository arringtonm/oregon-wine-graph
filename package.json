{
  "name": "oregon-wine-graph",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "release": "npm version minor --no-git-tag-version",
    "dev": "vite",
    "build": "vue-tsc -b && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:fetch": "tsx tools/check/fetchSources.ts",
    "check": "tsx tools/check/run.ts",
    "check:calibrate": "tsx tools/check/calibrate.ts",
    "check:apply": "tsx tools/check/apply.ts",
    "discover:crawl": "tsx tools/discover/crawl.ts",
    "discover:triage": "tsx tools/discover/triage.ts",
    "geo:locate": "tsx tools/geo/locate.ts",
    "geo:avas": "tsx tools/geo/avaCheck.ts",
    "owha:fetch": "tsx tools/discover/owha.ts",
    "owha:match": "tsx tools/discover/owhaMatch.ts",
    "owha:link": "tsx tools/discover/owhaLink.ts",
    "discover:merge": "tsx tools/discover/merge.ts",
    "roles:titles": "tsx tools/roles/titles.ts",
    "layout:reset": "node -e \"require('fs').writeFileSync('src/data/layout.json', JSON.stringify({version: 1, positions: {}}, null, 1) + '\\\\n')\"",
    "db:migrate:local": "wrangler d1 migrations apply oregon-wine-flags --local",
    "worker:dev": "npm run build && wrangler dev --port 8788"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "cytoscape": "3.34.3",
    "cytoscape-fcose": "2.2.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/cytoscape-fcose": "2.2.5",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "axe-core": "4.14.0",
    "jsdom": "25.0.1",
    "tsx": "4.23.15",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "5.0.4",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.151.0"
  }
}
